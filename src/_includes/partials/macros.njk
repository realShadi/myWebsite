{% macro icon(name) -%}
<svg viewBox="0 0 24 24" aria-hidden="true">
{%- if name == "globe" -%}<circle cx="12" cy="12" r="8.5"/><ellipse cx="12" cy="12" rx="3.6" ry="8.5"/><path d="M3.5 12h17"/>
{%- elif name == "tally" -%}<path d="M6.5 5.5v13M10.2 5.5v13M13.9 5.5v13M17.6 5.5v13M3.5 15.5l17-7"/>
{%- elif name == "book" -%}<path d="M12 6.6c-2.1-1.4-4.9-1.9-8-1.5v12.6c3.1-.4 5.9.1 8 1.5 2.1-1.4 4.9-1.9 8-1.5V5.1c-3.1-.4-5.9.1-8 1.5zM12 6.6v12.6"/>
{%- elif name == "plane" -%}<path d="M20.5 3.5L3.5 10.4l6.6 2.5 2.5 6.6 7.9-16zM10.1 12.9l10.4-9.4"/>
{%- elif name == "dice" -%}<rect x="4" y="4" width="16" height="16" rx="3.5"/><path d="M8.5 8.5h.01M15.5 8.5h.01M12 12h.01M8.5 15.5h.01M15.5 15.5h.01"/>
{%- elif name == "pen" -%}<path d="M4 20l1.2-4.6L16.4 4.2a1.7 1.7 0 0 1 2.4 0l1 1a1.7 1.7 0 0 1 0 2.4L8.6 18.8 4 20zM14.5 6.1l3.4 3.4"/>
{%- endif -%}
</svg>
{%- endmacro %}

{% macro windowBar(path) -%}
<div class="window-bar" aria-hidden="true"><span class="lights"><i></i><i></i><i></i></span><span class="window-path">{{ path }}</span></div>
{%- endmacro %}

{% macro pageHead(path, title, lede) %}
<section class="page-head">
  <div class="wrap">
    <div class="window">
      {{ windowBar(path) }}
      <div class="window-body">
        <h1 class="display-2">{{ title }}</h1>
        {%- if lede %}
        <p class="lede comment">{{ lede }}</p>
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{% endmacro %}

{% macro projectTile(project, root, span) %}
<li class="tile project-tile span-{{ span }}{% if project.data.fill %} fill-{{ project.data.fill }}{% endif %}">
  <h3 class="struct"><a class="stretch" href="{{ root }}{{ project.url | path }}">{{ project.data.title }}</a></h3>
  <p>{{ project.data.summary }}</p>
  <p class="tile-meta"><span class="str">{{ project.data.kind }}</span><span class="num">{{ project.data.year }}</span></p>
  <span class="tile-icon" aria-hidden="true">{{ icon(project.data.icon) }}</span>
</li>
{% endmacro %}

{% macro postTile(post, root, span) %}
<li class="tile post-tile span-{{ span }}">
  <p class="post-meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time><span>{{ post.content | readingTime }}</span></p>
  <h3><a class="stretch" href="{{ root }}{{ post.url | path }}">{{ post.data.title }}</a></h3>
  <p>{{ post.data.summary }}</p>
  <p class="tags">{% for topic in post.data.topics %}<span>#{{ topic }}</span>{% endfor %}</p>
</li>
{% endmacro %}
