<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="{{ root }}index.html" aria-label="{{ site.name }}, home">
      <span class="brand-full">{{ site.name }}</span><span class="brand-short" aria-hidden="true">{{ site.shortName }}</span>
    </a>
    <nav class="tabs" aria-label="Main">
      {%- for item in site.nav %}
      <a class="tab{% if item.key == section %} is-active{% endif %}" href="{{ root }}{{ item.url }}"{% if item.url == (page.url | path) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>
