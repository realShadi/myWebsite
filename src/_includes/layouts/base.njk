<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ description or summary or site.description }}">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#1f1f24">
<link rel="icon" href="{{ root }}assets/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..700&family=JetBrains+Mono:wght@400;500;700;800&display=swap">
<link rel="stylesheet" href="{{ root }}assets/css/site.css">
</head>
<body>
<!-- page:start -->
<a class="skip" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<!-- page:end -->
<script src="{{ root }}assets/js/site.js" defer></script>
{%- for file in scripts %}
<script src="{{ root }}assets/js/{{ file }}" defer></script>
{%- endfor %}
</body>
</html>
